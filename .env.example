# 上游资源站（要镜像的源）
SOURCE_HOST=https://fndesk.roceos.net:4433

# 同步频率：支持 7d / 24h / 60m / 1w / 3600(秒)，默认 7d（一周一次）
SYNC_INTERVAL=7d

# 并发下载线程数
SYNC_WORKERS=6

# 是否同步台词语音（/data/ships + /azurlane/*.ogg），默认关（体积较大）
SYNC_VOICES=false

# 语音数据语言：CN,EN,JP,KR,TW
SYNC_VOICE_LANGS=CN

# 最多同步多少个模型（0=全部）；调试/部分镜像用
SYNC_LIMIT=0

# 是否强制重新下载（忽略本地缓存）
SYNC_FORCE=false

# 本地缺失文件时是否回源代理（true=透明镜像；false=缺失即 404）
PROXY_FALLBACK=true

# 同步时若需走代理访问外网（容器内），填写宿主机代理地址
# HTTPS_PROXY=http://host.docker.internal:7897
