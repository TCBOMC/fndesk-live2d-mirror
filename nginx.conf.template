server {
    listen 80;
    server_name _;
    root /data/mirror;
    index index.html;
    charset utf-8;
    client_max_body_size 100m;

    # 与上游一致：跨域全开（组件纯浏览器端加载，无需 cookie）
    add_header Access-Control-Allow-Origin "*" always;

    # 本地优先，缺失再回源（PROXY_FALLBACK=false 时缺失即 404）
    location / {
        try_files $uri $uri/ ___FALLBACK___;
    }

    # 回源代理（仅当 PROXY_FALLBACK=true）
    location @upstream {
        proxy_pass ___UPSTREAM___;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_set_header Host ___UPSTREAM_HOST___;
        proxy_set_header User-Agent "Mozilla/5.0";
        proxy_set_header Referer "";
        proxy_set_header Origin "";
        proxy_set_header Accept "*/*";
        proxy_http_version 1.1;
        add_header Access-Control-Allow-Origin "*" always;
    }
}
